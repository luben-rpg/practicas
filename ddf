<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MI CRM - Registro de Clientes</title>
    <link rel="stylesheet" href="estilo.css">
</head>
<body>
    <main class="registro-container">
        <section class="registro-card">
            <header>
                <h1>Registro de Clientes</h1>
                <p>Complete la información solicitada</p>
            </header>

            <!-- FORMULARIO -->

            <form action="#" method="POST">
                <fieldset class="grid-fieldset">
                <div class="form-group">
                    <label for="nombre">Nombre Completo</label>
                    <input type="text" id="nombre" name="nombre" required placeholder="Ej. Pedro Perez">
                </div>

                <div class="form-group">
                    <label for="nombre">Cédula de Identidad</label>
                    <input type="text" id="cedula" name="cedula" required minlength="8" maxlength="10" placeholder="Ej.1234567891 (8-10 dígitos)">
                </div>

                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" required placeholder="cliente@gmail.com">
                </div>

               

                <div class="form-group">
                    <label for="nombre">Número Telefónico</label>
                    <input type="text" id="telefono" name="telefono" required maxlength="11" placeholder="Ej.04121234567(11 dígitos)">
                </div>

                

                <div class ="radio-option">
                    
                <label for="nombre">Tipo de Cliente</label>
                <label for="natural">Natural</label>
                <input type="radio" id="natural" name="natural">
                
                <label for="Juridico">Jurídico</label>
                <input type="radio" id="Juridico" name="Juridico">
                </div>

                <div>
                    <label for="sector">Sector / Industria</label>
                    <select name="sector" id="sector">
                        <option value="" disabled selected> --Seleccionar Sector--</option>
                        <option value="Tecnología">Tecnología e Informática</option>
                        <option value="Comercio">Comercio y Servicios</option>
                        <option value="Salud">Salud y Farmacia</option>
                        <option value="Educación">Educación y Capacitación</option>
                    </select>
                    </div>

                </fieldset>

                <div class="form-group">
                    <label for="direccion">Dirección Habitación / Fiscal (Opcional):</label>
                    <input type="text" id="direccion" name="direccion" required placeholder="Ingrese la dirección detallada..">
                </div>

  
 
                

                <button type="submit" class="btn-primary">Registrar Cliente</button>
            



            </form>


            <footer>
                <a href="lubenperezlogin.html"¿Ya tienes cuenta? Inicia sesión aquí</a>
            </footer>
        </section>
    </main>
    
</body>
</html>
